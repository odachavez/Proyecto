<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="GaleriaFrame">
		<bg>wxSYS_COLOUR_MENU</bg>
		<id_arg>0</id_arg>
		<object class="wxBoxSizer" variable="BoxSizer1" member="no">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<object class="wxBoxSizer" variable="BoxSizer2" member="no">
					<object class="sizeritem">
						<object class="wxStaticBoxSizer" variable="StaticBoxSizer1" member="no">
							<label>Ubicación</label>
							<object class="sizeritem">
								<object class="wxStaticText" name="ID_STATICTEXT2" variable="Localizacion" member="yes">
									<label></label>
									<size>715,20</size>
									<bg>wxSYS_COLOUR_WINDOW</bg>
									<style>wxBORDER_SIMPLE</style>
								</object>
								<flag>wxALL|wxEXPAND|wxFIXED_MINSIZE</flag>
								<border>5</border>
								<option>1</option>
							</object>
							<object class="sizeritem">
								<object class="wxButton" name="ID_BUTTON1" variable="btnLocaliza" member="yes">
									<label>...</label>
									<size>44,23</size>
									<handler function="OnbtnLocalizaClick" entry="EVT_BUTTON" />
								</object>
								<flag>wxALL</flag>
								<border>5</border>
							</object>
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
				</object>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
			</object>
			<object class="sizeritem">
				<object class="wxBoxSizer" variable="BoxSizer3" member="no">
					<object class="sizeritem">
						<object class="wxListBox" name="ID_LISTBOX1" variable="ListBox1" member="yes">
							<default>-1</default>
							<size>393,436</size>
							<handler function="OnListBox1Select" entry="EVT_LISTBOX" />
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxBoxSizer" variable="BoxSizer5" member="no">
							<orient>wxVERTICAL</orient>
							<object class="sizeritem">
								<object class="wxStaticBitmap" name="ID_STATICBITMAP2" variable="mostrarFoto" member="yes">
									<size>387,320</size>
									<bg>wxSYS_COLOUR_MENU</bg>
									<style>wxBORDER_SUNKEN</style>
								</object>
								<flag>wxALL|wxEXPAND</flag>
								<border>5</border>
								<option>1</option>
							</object>
							<object class="sizeritem">
								<object class="wxPanel" name="ID_PANEL4" variable="Panel2" member="yes">
									<size>389,139</size>
									<bg>wxSYS_COLOUR_WINDOW</bg>
									<style>wxBORDER_SIMPLE</style>
									<object class="wxBoxSizer" variable="BoxSizer6" member="no">
										<object class="sizeritem">
											<object class="wxStaticText" name="ID_STATICTEXT1" variable="txtDatos" member="yes">
												<label></label>
												<size>377,93</size>
											</object>
											<flag>wxALL</flag>
											<border>5</border>
											<option>1</option>
										</object>
									</object>
								</object>
								<flag>wxALL|wxEXPAND</flag>
								<border>4</border>
							</object>
						</object>
						<flag>wxEXPAND</flag>
					</object>
				</object>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<option>1</option>
			</object>
			<object class="sizeritem">
				<object class="wxBoxSizer" variable="BoxSizer4" member="no">
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON2" variable="btnAnte" member="yes">
							<label>Anterior</label>
							<size>161,25</size>
							<handler function="OnbtnAnteClick" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON3" variable="Button1" member="yes">
							<label>Agregar Foto</label>
							<size>127,25</size>
							<handler function="OnbtnAgregarClick" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON4" variable="btnEliminar" member="yes">
							<label>Eliminar Foto</label>
							<size>150,24</size>
							<handler function="OnButton2Click" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON5" variable="btnSig" member="yes">
							<label>Siguiente</label>
							<size>159,23</size>
							<handler function="OnbtnSigClick" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
						<border>5</border>
						<option>1</option>
					</object>
				</object>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
			</object>
		</object>
	</object>
</wxsmith>
